+      </div>
+      <div class="hud-right">
+        <button id="btnStageFs" class="pill" type="button">全屏</button>
+        <button id="btnStopCast" class="pill" type="button">退出投屏</button>
+      </div>
+    </div>
+    <button id="btnUnmute" class="unmute-btn hidden" type="button">点击开启声音 / 继续播放</button>
+  </section>
+
+<script>
+(function(){
+  const $ = (s) => document.querySelector(s);
+  const state = {
+    code: '',
+    secret: '',
+    seq: 0,
+    hls: null,
+    pollTimer: null,
+    hudTimer: null,
+    currentPayload: null,
+    proxyTried: false,
+  };
+
+  function setStatus(msg) {
+    $('#roomStatus').textContent = msg || '';
+  }
+
+  function destroyVideo() {
+    if (state.hls) {
+      try { state.hls.destroy(); } catch {}
+      state.hls = null;
+    }
+    const v = $('#tvVideo');
+    v.pause();
+    v.removeAttribute('src');
+    v.load();
+    $('#btnUnmute').classList.add('hidden');
+  }
+
+  function showStandby(msg) {
+    destroyVideo();
+    state.currentPayload = null;
+    $('#stage').classList.add('hidden');
+    $('#standby').classList.remove('hidden');
+    if (msg) setStatus(msg);
+  }
+
+  function touchHud() {
+    const hud = $('#hudTop');
+    hud.classList.remove('fade');
+    clearTimeout(state.hudTimer);
+    state.hudTimer = setTimeout(() => hud.classList.add('fade'), 4000);
+  }
+
+  async function tryAutoPlay(v) {
+    try {
+      v.muted = false;
+      await v.play();
+      $('#btnUnmute').classList.add('hidden');
+    } catch {
+      try {
+        v.muted = true;
+        await v.play();
+        $('#btnUnmute').classList.remove('hidden');
+      } catch {
+        $('#btnUnmute').classList.remove('hidden');
+      }
+    }
+  }
+
+  function mountMedia(payload, useProxy = false) {
+    if (!payload || !payload.url) return;
+    destroyVideo();
+    state.currentPayload = payload;
+    state.proxyTried = useProxy;
+    const url = (useProxy && payload.proxy_url) ? payload.proxy_url : payload.url;
+    const v = $('#tvVideo');
+    $('#standby').classList.add('hidden');
+    $('#stage').classList.remove('hidden');
+    $('#tvTitle').textContent = payload.title + (payload.episode ? (' · ' + payload.episode) : '');
+    $('#tvSub').textContent = '投屏码：' + state.code + (useProxy ? ' · 节点转发流' : '');
+    touchHud();
+
+    const pos = Number(payload.position) || 0;
+    const applyPos = () => {
+      if (pos > 1 && !payload.is_live && isFinite(v.duration) && pos < v.duration) {
+        v.currentTime = pos;
+      }
+    };
+
+    const fallbackToProxy = () => {
+      if (!state.proxyTried && payload.proxy_url && payload.proxy_url !== url) {
+        mountMedia(payload, true);
+        return true;
+      }
+      return false;
+    };
+
+    const isHls = /\.m3u8(\?|$)/i.test(url) || url.includes('/api/live/m3u8');
+    if (isHls && window.Hls && Hls.isSupported()) {
+      const hls = new Hls({ maxBufferLength: 30 });
+      state.hls = hls;
+      hls.loadSource(url);
+      hls.attachMedia(v);
+      hls.on(Hls.Events.MANIFEST_PARSED, () => {
+        if (pos > 1 && !payload.is_live) {
+          v.addEventListener('loadedmetadata', applyPos, { once: true });
+        }
+        tryAutoPlay(v);
+      });
+      hls.on(Hls.Events.ERROR, (_e, d) => {
+        if (!d || !d.fatal) return;
+        if (!fallbackToProxy()) {
+          $('#tvSub').textContent = '投屏码：' + state.code + ' · 视频流加载失败 (' + (d.details || d.type || 'ERROR') + ')';
+        }
+      });
+    } else {
+      v.src = url;
+      if (pos > 1 && !payload.is_live) {
+        v.addEventListener('loadedmetadata', applyPos, { once: true });
+      }
+      v.onerror = () => { fallbackToProxy(); };
+      tryAutoPlay(v);
+    }
+  }
+
+  function applyCommand(cmd) {
+    if (!cmd || !cmd.action) return;
+    const v = $('#tvVideo');
+    const p = cmd.payload || {};
+    if (cmd.action === 'load') {
+      mountMedia(p, false);
+    } else if (cmd.action === 'play') {
+      tryAutoPlay(v);
+      touchHud();
+    } else if (cmd.action === 'pause') {
+      v.pause();
+      touchHud();
+    } else if (cmd.action === 'seek') {
+      if (typeof p.time === 'number' && isFinite(p.time)) {
+        v.currentTime = Math.max(0, p.time);
+      } else if (typeof p.delta === 'number' && isFinite(p.delta)) {
+        v.currentTime = Math.max(0, (v.currentTime || 0) + p.delta);
+      }
+      touchHud();
+    } else if (cmd.action === 'volume') {
+      if (typeof p.level === 'number' && isFinite(p.level)) {
+        v.muted = false;
+        v.volume = Math.max(0, Math.min(1, p.level));
+      }
+    } else if (cmd.action === 'stop') {
+      showStandby('投放端已停止投屏，可重新输入投屏码连接');
+    }
+  }
+
+  async function createRoom() {
+    setStatus('正在生成 4 位投屏码…');
+    try {
+      const r = await fetch('/api/cast/room', { method: 'POST' });
+      const d = await r.json();
+      if (!r.ok || !d.code) throw new Error(d.error || '创建房间失败');
+      state.code = d.code;
+      state.secret = d.secret;
+      state.seq = 0;
+      $('#roomCode').textContent = d.code;
+      $('#tvSub').textContent = '投屏码：' + d.code;
+      setStatus('等待手机端连接投屏（房间 6 小时内有效）');
+    } catch (e) {
+      $('#roomCode').textContent = 'ERR';
+      setStatus('连接失败：' + (e.message || e));
+    }
+  }
+
+  async function pollLoop() {
+    if (state.code && state.secret) {
+      try {
+        const u = '/api/cast/poll?code=' + encodeURIComponent(state.code)
+          + '&secret=' + encodeURIComponent(state.secret)
+          + '&since=' + state.seq;
+        const r = await fetch(u, { cache: 'no-store' });
+        if (r.status === 404) {
+          await createRoom();
+        } else if (r.ok) {
+          const d = await r.json();
+          const cmds = Array.isArray(d.commands) ? d.commands : [];
+          for (const c of cmds) {
+            if (typeof c.seq === 'number' && c.seq > state.seq) state.seq = c.seq;
+            applyCommand(c);
+          }
+          if (typeof d.seq === 'number' && d.seq > state.seq) state.seq = d.seq;
+        }
+      } catch {}
+    }
+    state.pollTimer = setTimeout(pollLoop, 1500);
+  }
+
+  function toggleFs() {
+    if (document.fullscreenElement) {
+      document.exitFullscreen().catch(() => {});
+    } else {
+      document.documentElement.requestFullscreen?.().catch(() => {});
+    }
+  }
+
+  $('#btnRefreshCode').onclick = () => createRoom();
+  $('#btnTvFs').onclick = toggleFs;
+  $('#btnStageFs').onclick = toggleFs;
+  $('#btnStopCast').onclick = () => showStandby('已退出播放，等待新的投屏推送');
+  $('#btnUnmute').onclick = () => {
+    const v = $('#tvVideo');
+    v.muted = false;
+    v.play().catch(() => {});
+    $('#btnUnmute').classList.add('hidden');
+  };
+  $('#stage').addEventListener('pointermove', touchHud);
+  $('#stage').addEventListener('click', touchHud);
+
+  createRoom().then(() => { pollLoop(); });
+})();
+</script>
+</body>
+</html>
