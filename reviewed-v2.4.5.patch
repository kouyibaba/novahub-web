+}
+test('delete removes matching resume only and preserves collection', () => {
+  const H = moduleUnderTest();
+  const state = {history:[{srcId:'a',id:'1',at:10},{srcId:'b',id:'1',at:10}],progress:{'a:1':{time:10},'b:1':{time:20}},like:[{id:'1',srcId:'a'}]};
